#!/usr/bin/env python3
"""Write a node definition into a client inventory, for build.yml.

    scripts/new-node <client inventory>

It reads its defaults from <client inventory>/intake/defaults.yml, if that
file exists, and writes <client inventory>/intake/<node label>.<client
domain>.yml, named after the node's fully qualified domain name, mode 0644
like any file in the client inventory. Build the node with
scripts/build <client inventory> <fqdn>.

A node definition holds no secret. It names its batch in raw_node_batch,
and the build reads the batch's password hashes through uc_secret from
~/.secrets/uc/build/batches/<batch>.yml, which scripts/new-batch writes.
new-node refuses a defaults file that holds a password hash, and warns,
without reading it, when the batch's file does not exist.
"""

import datetime
import ipaddress
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

GROUP_VARS = Path(__file__).resolve().parent.parent / "inventory" / "group_vars" / "all"
LABELS_FILE = GROUP_VARS / "labels.yml"
PLATFORMS_FILE = GROUP_VARS / "platforms.yml"
SSH_FILE = GROUP_VARS / "ssh.yml"
BATCHES_FILE = GROUP_VARS / "batches.yml"

# Set by main() from the client inventory argument.
INTAKE_DIR = None
DEFAULTS_FILE = None

# Keys a node definition or defaults file no longer holds: the hashes are in
# the batch. A crypt hash anywhere in the file is refused too.
HASH_KEYS = ("root_password_hash", "initial_password_hash")
CRYPT_HASH = re.compile(r"\$(?:1|5|6|y|2[aby])\$[./A-Za-z0-9$]{8,}")

# Used when a value is in neither the defaults file nor typed in.
FALLBACKS = {
    "node_label": "raw",
    "platform": "incus",
    "initial_user": "initial",
    "ssh_public_key": "~/.ssh/id_ed25519.pub",
    "ssh_port": 22,
    "ssh_sources": [],
}

DOMAIN_LABEL = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
USER_NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
KEY_TYPES = ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-", "sk-ssh-ed25519", "sk-ecdsa-sha2-")


class Invalid(Exception):
    """A value that does not meet its rule. The message says why."""


def show(path):
    """A path as the operator would type it, with ~ for the home directory."""
    text = str(path)
    home = str(Path.home())
    return "~" + text[len(home):] if text.startswith(home) else text


def load_defaults():
    if not DEFAULTS_FILE.exists():
        return None
    text = DEFAULTS_FILE.read_text(encoding="utf-8")
    data = yaml.safe_load(text) or {}
    if not isinstance(data, dict):
        sys.exit(f"new-node: {show(DEFAULTS_FILE)} must be a mapping of settings.")
    if any(key in data for key in HASH_KEYS) or CRYPT_HASH.search(text):
        sys.exit(
            f"new-node: {show(DEFAULTS_FILE)} holds a password hash, and a client inventory holds no secret. "
            "Remove root_password_hash and initial_password_hash from it: the hashes are in the batch, "
            "which scripts/new-batch writes. See en/docs/guides/0-set-up-a-client.md."
        )
    return data


def load_group_var(path, name, kind):
    """One value from a file in inventory/group_vars/all/, which must be a
    non-empty value of the given kind."""
    with path.open() as handle:
        value = (yaml.safe_load(handle) or {}).get(name)
    if not isinstance(value, kind) or not value:
        sys.exit(f"new-node: {show(path)} must hold a non-empty {kind.__name__} called {name}.")
    return value


NODE_LABELS = [str(label) for label in load_group_var(LABELS_FILE, "node_labels", list)]
PLATFORMS = load_group_var(PLATFORMS_FILE, "platforms", dict)
# The same rule build.yml checks node_address against.
NODE_ADDRESS = re.compile(load_group_var(SSH_FILE, "node_address_pattern", str))
# The same rule build.yml checks raw_node_batch against.
BATCH_NAME = re.compile(load_group_var(BATCHES_FILE, "raw_node_batch_pattern", str))


def no_quote_or_newline(value):
    if "'" in value or "\n" in value:
        raise Invalid("it may not contain a single quote or a newline")
    return value


def check_domain(value):
    value = no_quote_or_newline(value.strip().lower())
    labels = value.split(".")
    if len(value) > 253 or len(labels) < 2 or not all(DOMAIN_LABEL.match(label) for label in labels):
        raise Invalid("use DNS labels of letters, digits and hyphens, separated by dots, for example example.org")
    return value


def check_label(value):
    value = str(value).strip().lower()
    if value not in NODE_LABELS:
        raise Invalid(f"use one of {', '.join(NODE_LABELS)}")
    return value


def check_platform(value):
    value = str(value).strip().lower()
    if value not in PLATFORMS:
        raise Invalid(f"use one of {', '.join(PLATFORMS)}")
    return value


def check_address(value):
    """An address that meets node_address_pattern, written as ipaddress
    writes it, so an IPv6 address is in its short, lowercase form."""
    value = no_quote_or_newline(str(value).strip())
    if not NODE_ADDRESS.fullmatch(value):
        raise Invalid("use an IPv4 or IPv6 address, for example 203.0.113.10")
    return str(ipaddress.ip_address(value))


# The questions for fields a platform requires, by field name, as listed in
# inventory/group_vars/all/platforms.yml.
PLATFORM_QUESTIONS = {
    "node_address": ("Node address", check_address),
}


def check_user(value):
    value = no_quote_or_newline(value.strip())
    if value == "root":
        raise Invalid("the initial user cannot be root")
    if not USER_NAME.match(value):
        raise Invalid("use lowercase letters, digits, - and _, starting with a letter or _, at most 32 characters")
    return value


# The .pub file each key line was read from, to find its private key.
KEY_FILES = {}


def key_body(line):
    """The type and base64 of a key line, without its comment."""
    return tuple(line.split()[:2])


def check_key(value):
    """Accept a key line, or a path to a file holding one, and return the key line."""
    value = value.strip()
    path = None
    if not value.startswith(KEY_TYPES):
        path = Path(value).expanduser()
        if not path.is_file():
            raise Invalid("give an OpenSSH public key line, or the path to a .pub file")
        lines = path.read_text().strip().splitlines()
        value = lines[0].strip() if lines else ""
    no_quote_or_newline(value)
    if path is not None:
        KEY_FILES[key_body(value)] = path
    result = subprocess.run(
        ["ssh-keygen", "-l", "-f", "/dev/stdin"],
        input=value + "\n",
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise Invalid("ssh-keygen does not accept it as an OpenSSH public key")
    return value


def check_port(value):
    text = str(value).strip()
    if not text.isdigit() or not 1 <= int(text) <= 65535:
        raise Invalid("use a number from 1 to 65535")
    return int(text)


def check_sources(value):
    """Accept a list, or addresses and networks separated by spaces or commas."""
    items = value if isinstance(value, list) else re.split(r"[\s,]+", value.strip())
    sources = []
    for item in (str(item).strip() for item in items):
        if not item:
            continue
        try:
            sources.append(str(ipaddress.ip_network(no_quote_or_newline(item), strict=True)))
        except ValueError:
            raise Invalid(f"{item} is not an IPv4 or IPv6 address or network, or has host bits set") from None
    return sources


def check_batch(value):
    value = str(value).strip()
    if not BATCH_NAME.fullmatch(value):
        raise Invalid("use a batch name, raw-YYYY-MM-DD-NN, such as raw-1970-01-01-01")
    try:
        datetime.date.fromisoformat(value[4:14])
    except ValueError:
        raise Invalid("the batch name must hold a real date, raw-YYYY-MM-DD-NN") from None
    return value


def secrets_root():
    """uc-node's secrets root, as uc_secret finds it."""
    configured = os.environ.get("UC_NODE_SECRETS_DIR")
    return Path(configured).expanduser() if configured else Path.home() / ".secrets" / "uc" / "build"


def warn_missing_batch(batch):
    """Say when the batch has no file yet. Only its existence is checked: the
    file is never opened."""
    path = secrets_root() / "batches" / f"{batch}.yml"
    if not path.exists():
        print(
            f"\nWarning: {show(path)} does not exist, so the build will stop until it does.\n"
            f"Make it with scripts/new-batch {batch}."
        )


def describe(name, value):
    """A default as shown in square brackets."""
    if name == "ssh_public_key" and str(value).startswith(KEY_TYPES):
        parts = str(value).split()
        comment = f" {parts[2]}" if len(parts) > 2 else ""
        return f"{parts[0]} {parts[1][:12]}...{comment}"
    if name == "ssh_sources":
        return " ".join(value)
    return str(value)


def ask(label, name, default, check):
    """Ask for one value until it meets its rule. Enter accepts the default."""
    while True:
        shown = "" if default is None else describe(name, default)
        answer = input(f"{label} [{shown}]: ").strip()
        if not answer:
            if default is None:
                print("  A value is needed.")
                continue
            answer = default
        try:
            return check(answer)
        except Invalid as error:
            print(f"  {error}.")


def ask_sources(label, default):
    """Like ask(), but blank is a valid answer: it keeps the default, and an
    empty default means any source. "any" clears a default that is not
    empty."""
    while True:
        answer = input(f"{label} [{' '.join(default)}]: ").strip()
        if not answer:
            return default
        if answer.lower() == "any":
            return []
        try:
            return check_sources(answer)
        except Invalid as error:
            print(f"  {error}.")


def ask_yes(question, default):
    hint = "[Y/n]" if default else "[y/N]"
    while True:
        answer = input(f"{question} {hint}: ").strip().lower()
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False


def checked(name, value, check):
    """A value from the defaults file, checked against its rule."""
    try:
        return check(value)
    except Invalid as error:
        sys.exit(f"new-node: {name} in {show(DEFAULTS_FILE)}: {error}.")


SOURCES_LABEL = "Allow SSH only from (addresses or networks, blank for the default, any for any)"

QUESTIONS = [
    ("client_domain", "Client domain", check_domain),
    ("node_label", f"Node label ({', '.join(NODE_LABELS)})", check_label),
    ("platform", f"Platform ({', '.join(PLATFORMS)})", check_platform),
    ("initial_user", "Initial user", check_user),
    ("ssh_public_key", "SSH public key", check_key),
    ("ssh_port", "SSH port", check_port),
    ("ssh_sources", SOURCES_LABEL, check_sources),
    ("raw_node_batch", "Batch (raw-YYYY-MM-DD-NN)", check_batch),
]


# Asked even when the defaults file is used, since they differ from node to
# node. A platform's own fields, such as node_address, are always asked too.
ALWAYS_ASKED = ("node_label", "platform", "raw_node_batch")


def ask_platform_fields(platform):
    """Ask for the fields the platform requires, as listed in platforms.yml."""
    fields = (PLATFORMS[platform] or {}).get("required_fields") or []
    values = {}
    for field in fields:
        if field not in PLATFORM_QUESTIONS:
            sys.exit(f"new-node: {show(PLATFORMS_FILE)} requires {field} for {platform}, and new-node does not know how to ask for it.")
        label, check = PLATFORM_QUESTIONS[field]
        values[field] = ask(label, field, None, check)
    return values


def confirm_sources(values):
    """On the ssh platform, the firewall allows SSH only from ssh_sources, so
    a list without this controller's public address locks the build out.
    Ask until the list is confirmed, or empty."""
    while values["platform"] == "ssh" and values["ssh_sources"]:
        print(
            f"  The firewall will allow SSH only from {' '.join(values['ssh_sources'])}. "
            "This must include this controller's own public address, or the build locks itself out."
        )
        if ask_yes("Does it include this controller's public address?", False):
            return
        values["ssh_sources"] = ask_sources(SOURCES_LABEL, values["ssh_sources"])


def gather(defaults):
    use_defaults = defaults is not None and ask_yes(f"Use defaults from {show(DEFAULTS_FILE)}?", True)
    defaults = defaults or {}
    values = {}

    for name, label, check in QUESTIONS:
        default = defaults.get(name, FALLBACKS.get(name))
        if use_defaults and name in defaults and name not in ALWAYS_ASKED:
            values[name] = checked(name, defaults[name], check)
        elif name == "ssh_sources":
            values[name] = ask_sources(label, check(default))
        else:
            values[name] = ask(label, name, default, check)
        if name == "platform":
            values.update(ask_platform_fields(values[name]))

    confirm_sources(values)
    return values


def node_definition(values):
    platform_fields = {field: values[field] for field in PLATFORM_QUESTIONS if field in values}
    return {
        "client_domain": values["client_domain"],
        "node_label": values["node_label"],
        "platform": values["platform"],
        **platform_fields,
        "initial_username": values["initial_user"],
        "ssh_public_key": values["ssh_public_key"],
        "ssh_port": values["ssh_port"],
        "ssh_sources": values["ssh_sources"],
        "raw_node_batch": values["raw_node_batch"],
    }


def write(path, data):
    """Write the node definition, replacing any earlier one in one step.
    PyYAML folds a line that runs past column 80 at its next space, so an
    ed25519 key line, with its comment on a line of its own, meets the
    client inventory's yamllint limit of 120 characters."""
    INTAKE_DIR.mkdir(mode=0o755, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=INTAKE_DIR, prefix=f".{path.name}.")
    try:
        with os.fdopen(handle, "w") as out:
            out.write("---\n")
            out.write("# Node definition written by uc-node's scripts/new-node. No secrets:\n")
            out.write("# the password hashes are in the batch that raw_node_batch names.\n")
            yaml.safe_dump(data, out, default_flow_style=False, sort_keys=False, width=80)
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def private_key_path(key_line):
    """The private key that goes with the public key: the .pub file it was
    read from, or the matching .pub file in ~/.ssh, without .pub. A
    placeholder if neither is found."""
    body = key_body(key_line)
    candidates = [KEY_FILES[body]] if body in KEY_FILES else []
    candidates += sorted((Path.home() / ".ssh").glob("*.pub"))
    for public in candidates:
        try:
            lines = public.read_text().strip().splitlines()
        except OSError:
            continue
        if lines and key_body(lines[0]) == body and public.suffix == ".pub":
            return show(public.with_suffix(""))
    return "<path to the private key of ssh_public_key>"


def ssh_config_block(values):
    """The ~/.ssh/config entry the build needs for an ssh node. Ansible
    connects to node_address, so the Host line is the address: an alias
    with HostName does not match."""
    return "\n".join([
        f"# uc-node: {values['node_label']}.{values['client_domain']}",
        f"Host {values['node_address']}",
        f"    IdentityFile {private_key_path(values['ssh_public_key'])}",
        "    IdentitiesOnly yes",
        "    # Optional, only for manual ssh/scp; the build passes the user itself",
        f"    User {values['initial_user']}",
    ])


def main():
    global INTAKE_DIR, DEFAULTS_FILE
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if sys.argv[1:] in (["-h"], ["--help"]) else 2
    inventory = Path(sys.argv[1]).expanduser().resolve()
    if not inventory.is_dir():
        sys.exit(f"new-node: {sys.argv[1]} is not a directory. Make the client inventory first, "
                 "as en/docs/guides/0-set-up-a-client.md describes.")
    INTAKE_DIR = inventory / "intake"
    DEFAULTS_FILE = INTAKE_DIR / "defaults.yml"
    defaults = load_defaults()
    values = gather(defaults)
    fqdn = f"{values['node_label']}.{values['client_domain']}"
    path = INTAKE_DIR / f"{fqdn}.yml"
    question = "Replace" if path.exists() else "Write"
    if not ask_yes(f"{question} {show(path)}?", False):
        print("Nothing written.")
        return 1
    write(path, node_definition(values))
    print(f"Wrote {show(path)}")
    warn_missing_batch(values["raw_node_batch"])
    print(f"\nBuild it with:\n\n  scripts/build {show(inventory)} {fqdn}")
    if values["platform"] == "ssh":
        print(
            "\nThe build offers only the keys ~/.ssh/config names for the node's address, or the default key files.\n"
            "Add this to ~/.ssh/config, before any Host * block, if it is not there yet:\n"
        )
        print(ssh_config_block(values))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print("\nNothing written.")
        sys.exit(1)
