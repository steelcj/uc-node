#!/usr/bin/env python3
"""Write a node definition for build.yml.

Run it from the repository directory:

    scripts/new-node

It reads its defaults from ~/.secrets/uc-raw/defaults.yml, if that file
exists, and writes ~/.secrets/uc-raw/<client domain>.yml. Passwords are read
from the terminal and only their SHA-512 crypt hashes are written. Both files
are kept at mode 0600 in a directory of mode 0700.
"""

import getpass
import ipaddress
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

SECRETS_DIR = Path.home() / ".secrets" / "uc-raw"
DEFAULTS_FILE = SECRETS_DIR / "defaults.yml"

# Used when a value is in neither the defaults file nor typed in.
FALLBACKS = {
    "initial_user": "initial",
    "ssh_public_key": "~/.ssh/id_ed25519.pub",
    "ssh_port": 22,
    "ssh_sources": [],
}

DOMAIN_LABEL = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
USER_NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
KEY_TYPES = ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-", "sk-ssh-ed25519", "sk-ecdsa-sha2-")


class Invalid(Exception):
    """A value that does not meet its rule. The message says why."""


def show(path):
    """A path as the operator would type it, with ~ for the home directory."""
    text = str(path)
    home = str(Path.home())
    return "~" + text[len(home):] if text.startswith(home) else text


def check_private(path, kind):
    """Refuse a secrets file or directory that others can read."""
    mode = stat.S_IMODE(path.stat().st_mode)
    wanted = 0o700 if kind == "directory" else 0o600
    if mode & ~wanted:
        sys.exit(f"new-node: {show(path)} has mode {mode:04o}, it must be {wanted:04o}.")


def load_defaults():
    if not DEFAULTS_FILE.exists():
        return None
    check_private(SECRETS_DIR, "directory")
    check_private(DEFAULTS_FILE, "file")
    with DEFAULTS_FILE.open() as handle:
        data = yaml.safe_load(handle) or {}
    if not isinstance(data, dict):
        sys.exit(f"new-node: {show(DEFAULTS_FILE)} must be a mapping of settings.")
    return data


def no_quote_or_newline(value):
    if "'" in value or "\n" in value:
        raise Invalid("it may not contain a single quote or a newline")
    return value


def check_domain(value):
    value = no_quote_or_newline(value.strip().lower())
    labels = value.split(".")
    if len(value) > 253 or len(labels) < 2 or not all(DOMAIN_LABEL.match(label) for label in labels):
        raise Invalid("use DNS labels of letters, digits and hyphens, separated by dots, for example vishpala.com")
    return value


def check_user(value):
    value = no_quote_or_newline(value.strip())
    if value == "root":
        raise Invalid("the initial user cannot be root")
    if not USER_NAME.match(value):
        raise Invalid("use lowercase letters, digits, - and _, starting with a letter or _, at most 32 characters")
    return value


def check_key(value):
    """Accept a key line, or a path to a file holding one, and return the key line."""
    value = value.strip()
    if not value.startswith(KEY_TYPES):
        path = Path(value).expanduser()
        if not path.is_file():
            raise Invalid("give an OpenSSH public key line, or the path to a .pub file")
        lines = path.read_text().strip().splitlines()
        value = lines[0].strip() if lines else ""
    no_quote_or_newline(value)
    result = subprocess.run(
        ["ssh-keygen", "-l", "-f", "/dev/stdin"],
        input=value + "\n",
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise Invalid("ssh-keygen does not accept it as an OpenSSH public key")
    return value


def check_port(value):
    text = str(value).strip()
    if not text.isdigit() or not 1 <= int(text) <= 65535:
        raise Invalid("use a number from 1 to 65535")
    return int(text)


def check_sources(value):
    """Accept a list, or addresses and networks separated by spaces or commas."""
    items = value if isinstance(value, list) else re.split(r"[\s,]+", value.strip())
    sources = []
    for item in (str(item).strip() for item in items):
        if not item:
            continue
        try:
            sources.append(str(ipaddress.ip_network(no_quote_or_newline(item), strict=True)))
        except ValueError:
            raise Invalid(f"{item} is not an IPv4 or IPv6 address or network, or has host bits set") from None
    return sources


def check_hash(value):
    value = no_quote_or_newline(str(value).strip())
    if not value.startswith("$6$"):
        raise Invalid("it must be a SHA-512 crypt hash, as made by openssl passwd -6")
    return value


def describe(name, value):
    """A default as shown in square brackets."""
    if name == "ssh_public_key" and str(value).startswith(KEY_TYPES):
        parts = str(value).split()
        comment = f" {parts[2]}" if len(parts) > 2 else ""
        return f"{parts[0]} {parts[1][:12]}...{comment}"
    if name == "ssh_sources":
        return " ".join(value)
    return str(value)


def ask(label, name, default, check):
    """Ask for one value until it meets its rule. Enter accepts the default."""
    while True:
        shown = "" if default is None else describe(name, default)
        answer = input(f"{label} [{shown}]: ").strip()
        if not answer:
            if default is None:
                print("  A value is needed.")
                continue
            answer = default
        try:
            return check(answer)
        except Invalid as error:
            print(f"  {error}.")


def ask_sources(label, default):
    """Like ask(), but blank is a valid answer: it keeps the default, and an
    empty default means any source."""
    while True:
        answer = input(f"{label} [{' '.join(default)}]: ").strip()
        if not answer:
            return default
        try:
            return check_sources(answer)
        except Invalid as error:
            print(f"  {error}.")


def ask_yes(question, default):
    hint = "[Y/n]" if default else "[y/N]"
    while True:
        answer = input(f"{question} {hint}: ").strip().lower()
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False


def ask_password(label, minimum):
    while True:
        first = getpass.getpass(f"{label}: ")
        if len(first) < minimum:
            print(f"  At least {minimum} characters, please.")
            continue
        if getpass.getpass(f"{label} again: ") == first:
            return hash_password(first)
        print("  They did not match, try again.")


def hash_password(password):
    result = subprocess.run(
        ["openssl", "passwd", "-6", "-stdin"],
        input=password,
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def checked(name, value, check):
    """A value from the defaults file, checked against its rule."""
    try:
        return check(value)
    except Invalid as error:
        sys.exit(f"new-node: {name} in {show(DEFAULTS_FILE)}: {error}.")


QUESTIONS = [
    ("client_domain", "Client domain", check_domain),
    ("initial_user", "Initial user", check_user),
    ("ssh_public_key", "SSH public key", check_key),
    ("ssh_port", "SSH port", check_port),
    ("ssh_sources", "Allow SSH only from (addresses or networks, blank for any)", check_sources),
]


def gather(defaults):
    use_defaults = defaults is not None and ask_yes(f"Use defaults from {show(DEFAULTS_FILE)}?", True)
    defaults = defaults or {}
    values = {}

    for name, label, check in QUESTIONS:
        default = defaults.get(name, FALLBACKS.get(name))
        if use_defaults and name in defaults:
            values[name] = checked(name, defaults[name], check)
        elif name == "ssh_sources":
            values[name] = ask_sources(label, check(default))
        else:
            values[name] = ask(label, name, default, check)

    has_hashes = "root_password_hash" in defaults and "initial_password_hash" in defaults
    if has_hashes and (use_defaults or ask_yes("Use the default passwords?", True)):
        values["root_password_hash"] = checked("root_password_hash", defaults["root_password_hash"], check_hash)
        values["initial_password_hash"] = checked("initial_password_hash", defaults["initial_password_hash"], check_hash)
    else:
        values["root_password_hash"] = ask_password("Root password", 1)
        values["initial_password_hash"] = ask_password(
            f"Password for {values['initial_user']} (at least 15 characters)", 15
        )
    return values


def node_definition(values):
    return {
        "hostname": values["client_domain"],
        "root_password_hash": values["root_password_hash"],
        "initial_username": values["initial_user"],
        "initial_password_hash": values["initial_password_hash"],
        "ssh_public_key": values["ssh_public_key"],
        "ssh_port": values["ssh_port"],
        "ssh_sources": values["ssh_sources"],
    }


def write(path, data):
    SECRETS_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    check_private(SECRETS_DIR, "directory")
    handle, temporary = tempfile.mkstemp(dir=SECRETS_DIR, prefix=f".{path.name}.")
    try:
        with os.fdopen(handle, "w") as out:
            out.write("---\n")
            out.write("# Node definition written by scripts/new-node.\n")
            yaml.safe_dump(data, out, default_flow_style=False, sort_keys=False, width=1000)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def main():
    if len(sys.argv) > 1:
        print(__doc__.strip())
        return 0 if sys.argv[1] in ("-h", "--help") else 2
    defaults = load_defaults()
    values = gather(defaults)
    path = SECRETS_DIR / f"{values['client_domain']}.yml"
    question = "Replace" if path.exists() else "Write"
    if not ask_yes(f"{question} {show(path)}?", False):
        print("Nothing written.")
        return 1
    write(path, node_definition(values))
    print(f"Wrote {show(path)}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, EOFError):
        print("\nNothing written.")
        sys.exit(1)
